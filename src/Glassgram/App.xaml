<Application x:Class="Glassgram.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Glassgram.Controls">
  <Application.Resources><ResourceDictionary>
    <ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary x:Key="Dark">
        <LinearGradientBrush x:Key="WindowGlassBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B8182738" Offset="0"/><GradientStop Color="#C8111725" Offset="1"/></LinearGradientBrush>
        <SolidColorBrush x:Key="GlassPanelBrush" Color="#357C9DAF"/>
        <SolidColorBrush x:Key="GlassConversationBrush" Color="#207C9DAF"/>
        <SolidColorBrush x:Key="GlassMutedBrush" Color="#B6C8D9"/>
      </ResourceDictionary>
      <ResourceDictionary x:Key="Light">
        <LinearGradientBrush x:Key="WindowGlassBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#C8EAF4F8" Offset="0"/><GradientStop Color="#D8DCE9F2" Offset="1"/></LinearGradientBrush>
        <SolidColorBrush x:Key="GlassPanelBrush" Color="#A8FFFFFF"/>
        <SolidColorBrush x:Key="GlassConversationBrush" Color="#82FFFFFF"/>
        <SolidColorBrush x:Key="GlassMutedBrush" Color="#526577"/>
      </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary.MergedDictionaries>
    <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
  </ResourceDictionary.MergedDictionaries>
    <Style TargetType="MenuFlyoutPresenter">
      <Setter Property="Background"><Setter.Value><AcrylicBrush TintColor="#607D96" TintOpacity="0.68" TintLuminosityOpacity="0.28" FallbackColor="#E0223140"/></Setter.Value></Setter>
      <Setter Property="BorderBrush" Value="#55FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="6"/>
    </Style>
    <Style TargetType="controls:GlassPanel">
      <Setter Property="CornerRadius" Value="28"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="controls:GlassPanel">
          <Grid>
            <Border CornerRadius="{TemplateBinding CornerRadius}" Opacity="{TemplateBinding GlassOpacity}" Translation="0,2,16"><Border.Shadow><ThemeShadow/></Border.Shadow><Border.Background><AcrylicBrush TintColor="#47667E" TintOpacity="0.62" TintLuminosityOpacity="0.30" FallbackColor="#E0223342"/></Border.Background></Border>
            <Border CornerRadius="{TemplateBinding CornerRadius}"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#34FFFFFF"/><GradientStop Color="#0CFFFFFF" Offset="0.38"/><GradientStop Color="#18102F49" Offset="1"/></LinearGradientBrush></Border.Background></Border>
            <Border Height="2" Margin="24,1,24,0" VerticalAlignment="Top" CornerRadius="2" Opacity="0.8"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00FFFFFF"/><GradientStop Color="#A8FFFFFF" Offset="0.45"/><GradientStop Color="#18FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
            <Border CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
            <ContentPresenter Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="BorderBrush" Value="#52FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="BorderBrush" Value="#52FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="CornerRadius" Value="16"/>
    </Style>
    <Style TargetType="ListViewItem">
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Margin" Value="0,2"/>
    </Style>
  </ResourceDictionary></Application.Resources>
</Application>
