<Application x:Class="Glassgram.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources><ResourceDictionary>
    <ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary x:Key="Dark">
        <LinearGradientBrush x:Key="WindowGlassBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#D9182738" Offset="0"/><GradientStop Color="#E6111725" Offset="1"/></LinearGradientBrush>
        <SolidColorBrush x:Key="GlassPanelBrush" Color="#277C9DAF"/>
        <SolidColorBrush x:Key="GlassConversationBrush" Color="#157C9DAF"/>
        <SolidColorBrush x:Key="GlassMutedBrush" Color="#B6C8D9"/>
      </ResourceDictionary>
      <ResourceDictionary x:Key="Light">
        <LinearGradientBrush x:Key="WindowGlassBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E7EAF4F8" Offset="0"/><GradientStop Color="#F2DCE9F2" Offset="1"/></LinearGradientBrush>
        <SolidColorBrush x:Key="GlassPanelBrush" Color="#C7FFFFFF"/>
        <SolidColorBrush x:Key="GlassConversationBrush" Color="#A9FFFFFF"/>
        <SolidColorBrush x:Key="GlassMutedBrush" Color="#526577"/>
      </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary.MergedDictionaries>
    <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
  </ResourceDictionary.MergedDictionaries></ResourceDictionary></Application.Resources>
</Application>
