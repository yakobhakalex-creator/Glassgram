<Window x:Class="Glassgram.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Glassgram.Controls"
    xmlns:local="using:Glassgram"
    Title="Glassgram">
  <Grid x:Name="Root" RequestedTheme="Dark" Background="Transparent" AllowDrop="True" DragOver="ConversationDragOver" Drop="ConversationDrop" KeyDown="RootKeyDown">
    <Grid.Resources>
      <FontFamily x:Key="ChatEmojiFont">ms-appx:///Assets/Emoji/NotoColorEmoji.ttf#Noto Color Emoji</FontFamily>
      <FontFamily x:Key="ChatTextFont">Segoe UI, ms-appx:///Assets/Emoji/NotoColorEmoji.ttf#Noto Color Emoji</FontFamily>
      <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
      <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Grid.Resources>
    <Grid x:Name="ScaledRoot" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Grid.RenderTransform><ScaleTransform x:Name="InterfaceScaleTransform"/></Grid.RenderTransform>
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Image x:Name="WallpaperLayer" Grid.RowSpan="2" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False"/>
    <Rectangle x:Name="WallpaperVeil" Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0.16"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#281B3E59"/><GradientStop Color="#0CFFFFFF" Offset="0.46"/><GradientStop Color="#36213855" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
    <Grid x:Name="TitleBar" Margin="28,0,150,0">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <FontIcon Glyph="&#xE8F2;" FontSize="17" Foreground="#9FD8F5"/>
        <TextBlock Text="Glassgram" FontSize="16" FontWeight="SemiBold"/>
      </StackPanel>
    </Grid>
    <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="LeftCompact" IsPaneOpen="True" OpenPaneLength="220" CompactPaneLength="76" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="True" SelectionChanged="Navigate" PaneOpened="NavigationPaneOpened" PaneClosed="NavigationPaneClosed">
      <NavigationView.PaneHeader>
        <Border x:Name="BrandPanel" Margin="8,8,8,14" Padding="14" CornerRadius="24" BorderBrush="#65FFFFFF" BorderThickness="1" Background="#2AFFFFFF">
          <StackPanel Orientation="Horizontal" Spacing="12"><Border Width="44" Height="44" CornerRadius="22" Background="#3BFFFFFF"><FontIcon Glyph="&#xE8F2;" FontSize="22" Foreground="#D9F5FF"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Glassgram" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Telegram + локальный ИИ" FontSize="11" Opacity="0.72"/></StackPanel></StackPanel>
        </Border>
      </NavigationView.PaneHeader>
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Сообщения" Tag="chats" Icon="Message" IsSelected="True"/>
        <NavigationViewItem Content="ИИ" Icon="Contact" SelectsOnInvoked="False">
          <NavigationViewItem.MenuItems>
            <NavigationViewItem Content="ИИ-агенты" Tag="agent" Icon="Contact"/>
            <NavigationViewItem Content="Локальный ИИ" Tag="ai" Icon="Help"/>
            <NavigationViewItem Content="Суммаризация" Tag="summarize"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Черновик ответа" Tag="draft"><NavigationViewItem.Icon><FontIcon Glyph="&#xE70F;"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Перевод" Tag="translate"><NavigationViewItem.Icon><FontIcon Glyph="&#xF2B7;"/></NavigationViewItem.Icon></NavigationViewItem>
          </NavigationViewItem.MenuItems>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.PaneCustomContent>
        <Grid Margin="6,8,6,6" RowSpacing="6">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="ПАПКИ" FontSize="10" FontWeight="SemiBold" Opacity="0.55" Margin="10,0,0,2"/>
          <ListView x:Name="FolderList" Grid.Row="1" SelectionMode="Single" SelectionChanged="SelectFolder" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/><Setter Property="MinHeight" Value="54"/></Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate><DataTemplate><StackPanel MinHeight="58" Padding="4,3" Spacing="2" ToolTipService.ToolTip="{Binding Title}">
              <Grid Width="32" Height="32" HorizontalAlignment="Center">
                <Border CornerRadius="12" Background="#24FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1"/>
                <FontIcon Glyph="{Binding Icon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border Visibility="{Binding UnreadVisibility}" Background="#5CA9D4" CornerRadius="9" Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="{Binding UnreadText}" FontSize="9" Foreground="White"/></Border>
              </Grid>
              <TextBlock Text="{Binding Title}" FontSize="9" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Stretch"/>
            </StackPanel></DataTemplate></ListView.ItemTemplate>
          </ListView>
          <Button Grid.Row="2" Click="ShowArchiveChats" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="6,5"><StackPanel Spacing="2"><FontIcon Glyph="&#xE8B7;" HorizontalAlignment="Center"/><TextBlock Text="Архив" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="FolderManagementButton" Grid.Row="3" Click="OpenFolderSettings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="6,5"><StackPanel Spacing="2"><FontIcon Glyph="&#xE713;" HorizontalAlignment="Center"/><TextBlock Text="Папки" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Button>
        </Grid>
      </NavigationView.PaneCustomContent>
      <Grid Margin="10,0,18,18">
        <Grid x:Name="AuthPage" Visibility="Collapsed">
          <Border MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{ThemeResource GlassPanelBrush}" BorderBrush="#48FFFFFF" BorderThickness="1" CornerRadius="24" Padding="36">
            <ScrollViewer MaxHeight="650"><StackPanel Spacing="16">
              <TextBlock Text="Telegram в Glassgram" FontSize="30" FontWeight="SemiBold" />
              <TextBlock x:Name="AuthDescription" Text="Подключаем Telegram…" Foreground="#B6C8D9" TextWrapping="Wrap"/>
              <StackPanel x:Name="CredentialsPanel" Spacing="10" Visibility="Collapsed">
                <TextBox x:Name="ApiIdInput" Header="API ID" PlaceholderText="Число из my.telegram.org" InputScope="Number"/>
                <PasswordBox x:Name="ApiHashInput" Header="API hash" PlaceholderText="Ключ из my.telegram.org"/>
                <TextBlock Text="Получить API ID и API hash можно на my.telegram.org. Они нужны TDLib для входа." Foreground="#B6C8D9" TextWrapping="Wrap"/>
                <Button x:Name="SaveCredentialsButton" Content="Подключить Telegram" Click="SaveTelegramCredentials"/>
              </StackPanel>
              <StackPanel x:Name="PhonePanel" Spacing="12" Visibility="Collapsed">
                <TextBox x:Name="PhoneInput" Header="Номер телефона" PlaceholderText="+380…" InputScope="TelephoneNumber"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="PhoneButton" Content="Получить код" Click="SubmitPhone"/>
                  <Button x:Name="QrButton" Content="Войти по QR-коду" Click="StartQr"/>
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="QrPanel" Spacing="12" Visibility="Collapsed">
                <Border Background="White" Padding="12" CornerRadius="12" HorizontalAlignment="Left"><Image x:Name="QrImage" Width="220" Height="220"/></Border>
                <TextBlock Text="Открой Telegram на телефоне → Настройки → Устройства → Подключить устройство и отсканируй код." TextWrapping="Wrap" Foreground="#B6C8D9"/>
                <Button Content="Войти по номеру" Click="ShowPhone" HorizontalAlignment="Left"/>
              </StackPanel>
              <StackPanel x:Name="CodePanel" Spacing="12" Visibility="Collapsed">
                <TextBox x:Name="CodeInput" Header="Код подтверждения" PlaceholderText="Код из Telegram или SMS"/>
                <Button x:Name="CodeButton" Content="Продолжить" Click="SubmitCode" HorizontalAlignment="Left"/>
              </StackPanel>
              <StackPanel x:Name="EmailPanel" Spacing="12" Visibility="Collapsed">
                <TextBox x:Name="EmailInput" Header="Адрес электронной почты" PlaceholderText="Адрес для кода Telegram"/>
                <Button x:Name="EmailButton" Content="Отправить код" Click="SubmitEmail" HorizontalAlignment="Left"/>
              </StackPanel>
              <StackPanel x:Name="EmailCodePanel" Spacing="12" Visibility="Collapsed">
                <TextBox x:Name="EmailCodeInput" Header="Код из письма"/>
                <Button x:Name="EmailCodeButton" Content="Подтвердить" Click="SubmitEmailCode" HorizontalAlignment="Left"/>
              </StackPanel>
              <StackPanel x:Name="PasswordPanel" Spacing="12" Visibility="Collapsed">
                <PasswordBox x:Name="PasswordInput" Header="Облачный пароль Telegram"/>
                <Button x:Name="PasswordButton" Content="Войти" Click="SubmitPassword" HorizontalAlignment="Left"/>
              </StackPanel>
              <TextBlock x:Name="AuthError" Foreground="#FFB8AC" TextWrapping="Wrap"/>
            </StackPanel></ScrollViewer>
          </Border>
        </Grid>
        <Grid x:Name="ChatsPage" ColumnSpacing="0">
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="ChatColumn" Width="340" MinWidth="250"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <controls:GlassPanel x:Name="ChatListPanel" CornerRadius="28" BorderBrush="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid Margin="10" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock Text="Чаты" FontSize="25" FontWeight="SemiBold" Margin="10,5,8,0"/>
              <TextBox x:Name="ChatSearch" Grid.Row="1" PlaceholderText="Поиск в Glassgram" TextChanged="SearchChats" GotFocus="SearchFocus"/>
              <Grid x:Name="SearchUI" Grid.Row="2" RowSpacing="8">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                  <StackPanel x:Name="SearchProgressPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed"><ProgressRing x:Name="SearchProgressRing" Width="18" Height="18" IsActive="False"/><TextBlock x:Name="SearchLoadingText" VerticalAlignment="Center" FontSize="12" Text="Ищем…"/></StackPanel>
                  <Grid x:Name="RecentSearchHeader" Visibility="Collapsed" Margin="8,3"><TextBlock Text="Недавние" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="Очистить историю" Click="ClearRecentSearches" HorizontalAlignment="Right" Padding="9,3"/></Grid>
                </Grid>
                <TextBlock x:Name="SearchErrorText" Grid.Row="1" Foreground="#FFB8AC" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                <TextBlock x:Name="EmptySearchResults" Grid.Row="2" Text="Ничего не найдено" FontSize="14" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                <ListView x:Name="SearchResultsList" Grid.Row="3" SelectionMode="Single" SelectionChanged="SelectSearchResult" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid Padding="8,5" ColumnSpacing="11" MinHeight="66">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="4" Text="{Binding SectionTitle}" FontSize="13" FontWeight="SemiBold" Margin="2,8,2,5" Visibility="{Binding SectionTitle, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <Grid Grid.Row="1" Grid.ColumnSpan="4" ColumnSpacing="11" MinHeight="56">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid Width="46" Height="46" VerticalAlignment="Center">
                          <Ellipse Fill="#567F99"/><TextBlock Text="{Binding AvatarLetter}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
                          <Ellipse><Ellipse.Fill><ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" LineHeight="21"/>
                            <TextBlock Text="{Binding Type}" Opacity="0.5" FontSize="11" FontStyle="Italic" Visibility="{Binding Type, Converter={StaticResource StringToVisibilityConverter}}"/>
                            <FontIcon Glyph="&#xE8FB;" FontSize="10" Foreground="#5CA9D4" Visibility="{Binding IsVerified, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <FontIcon Glyph="&#xE7BA;" FontSize="10" Foreground="#FF6B6B" Visibility="{Binding IsScam, Converter={StaticResource BoolToVisibilityConverter}}"/>
                          </StackPanel>
                          <TextBlock Text="{Binding Preview}" Opacity="0.65" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1" FontSize="12" LineHeight="18"/>
                          <TextBlock Text="{Binding ChatTitle}" Opacity="0.5" FontSize="11" FontStyle="Italic" Visibility="{Binding ChatTitle, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="8">
                          <TextBlock Text="{Binding TimeText}" Opacity="0.6" FontSize="11" HorizontalAlignment="Right"/>
                          <TextBlock Text="{Binding Username}" Opacity="0.5" FontSize="11" FontStyle="Italic" Visibility="{Binding Username, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>
                        <Button Grid.Column="3" Content="&#xE711;" FontFamily="Segoe Fluent Icons" Click="RemoveRecentSearch" Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibilityConverter}}" Width="32" Height="32" Padding="0" VerticalAlignment="Center" ToolTipService.ToolTip="Удалить из недавних"/>
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <Button x:Name="LoadMoreSearchMessages" Grid.Row="3" Content="Загрузить ещё сообщения" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" Click="OnLoadMoreSearchMessagesClick" Visibility="Collapsed"/>
              </Grid>
              <ListView x:Name="ChatList" Grid.Row="3" SelectionMode="Single" SelectionChanged="SelectChat" ContainerContentChanging="ChatContainerChanging" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemTemplate><DataTemplate>
                  <Grid Padding="8,5" ColumnSpacing="11" MinHeight="66">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Width="46" Height="46" VerticalAlignment="Center">
                      <Ellipse Fill="#567F99"/><TextBlock Text="{Binding AvatarLetter}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
                      <Ellipse><Ellipse.Fill><ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" LineHeight="21"/>
                      <TextBlock Text="{Binding Preview}" Opacity="0.65" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1" FontSize="12" LineHeight="18"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="8">
                      <TextBlock Text="{Binding TimeText}" Opacity="0.6" FontSize="11" HorizontalAlignment="Right"/>
                      <Border Visibility="{Binding UnreadVisibility}" Background="#5CA9D4" CornerRadius="10" Padding="6,1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding UnreadText}" FontSize="11" Foreground="White"/>
                      </Border>
                    </StackPanel>
                  </Grid>
                </DataTemplate></ListView.ItemTemplate>
              </ListView>
            </Grid>
          </controls:GlassPanel>
          <Grid Grid.Column="1" Background="Transparent" PointerPressed="ResizeChatPressed" PointerMoved="ResizeChatMoved" PointerReleased="ResizeChatReleased" PointerCaptureLost="ResizeChatCaptureLost" ToolTipService.ToolTip="Изменить ширину списка чатов"><Border Width="1" Background="#28FFFFFF" HorizontalAlignment="Center" Margin="0,22"/></Grid>
          <controls:GlassPanel x:Name="MessagesPanel" Grid.Column="2" CornerRadius="28" BorderBrush="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="FutureSidePanelColumn" Width="0" MinWidth="0" MaxWidth="340"/></Grid.ColumnDefinitions>
            <Grid x:Name="EmptyChat" Padding="48">
              <StackPanel VerticalAlignment="Center" MaxWidth="440" Spacing="18">
                <FontIcon Glyph="&#xE8F2;" FontSize="54" Foreground="#9FD8F5" HorizontalAlignment="Left"/>
                <TextBlock Text="Выбери чат" FontSize="36" FontWeight="SemiBold"/>
                <TextBlock Text="Сообщения появятся здесь." Opacity="0.7" FontSize="16"/>
              </StackPanel>
            </Grid>
            <Grid x:Name="ConversationPage" Visibility="Collapsed" RowSpacing="0">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <controls:GlassPanel x:Name="ConversationHeader" BorderBrush="Transparent" BorderThickness="0" Padding="12,7" Margin="4,4,4,2" CornerRadius="24,24,8,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="6"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Grid Width="42" Height="42" Tapped="OpenProfilePanel"><Ellipse Fill="#567F99"/><TextBlock x:Name="ActiveChatAvatarLetter" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/><Ellipse><Ellipse.Fill><ImageBrush x:Name="ActiveChatAvatarBrush" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse></Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Tapped="OpenProfilePanel"><TextBlock x:Name="ActiveChatTitle" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ActiveChatStatus" FontSize="12" Opacity="0.72" TextTrimming="CharacterEllipsis"/></StackPanel>
                  <Button Grid.Column="2" Content="&#xE718;" FontFamily="Segoe Fluent Icons" Width="40" Height="40" Click="OpenPinnedMessagesList" ToolTipService.ToolTip="Закреплённые сообщения"/>
                  <Button Grid.Column="3" Content="&#xE721;" FontFamily="Segoe Fluent Icons" Width="40" Height="40" Click="ToggleMessageSearch" ToolTipService.ToolTip="Поиск в чате"/><TextBox x:Name="MessageSearch" Grid.Column="4" Width="220" PlaceholderText="Поиск в чате" Visibility="Collapsed" TextChanged="SearchMessages"/>
                </Grid>
                <Grid x:Name="ChatSearchTools" Visibility="Collapsed" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ComboBox x:Name="ChatSearchSender" MinWidth="118" SelectionChanged="ChatSearchFilterChanged" ToolTipService.ToolTip="Отправитель"/>
                  <ComboBox x:Name="ChatSearchMedia" Grid.Column="1" MinWidth="118" SelectionChanged="ChatSearchFilterChanged" ToolTipService.ToolTip="Тип сообщений"/>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"><ProgressRing x:Name="ChatSearchProgress" Width="16" Height="16" IsActive="False"/><TextBlock x:Name="ChatSearchStatus" VerticalAlignment="Center" Opacity="0.72" TextTrimming="CharacterEllipsis"/></StackPanel>
                  <Button Grid.Column="3" Content="↑" Click="PreviousChatSearchResult" ToolTipService.ToolTip="Предыдущий результат"/>
                  <Button Grid.Column="4" Content="↓" Click="NextChatSearchResult" ToolTipService.ToolTip="Следующий результат"/>
                  <Button x:Name="ChatSearchMore" Grid.Column="5" Content="Ещё" Click="LoadMoreChatSearchResults" Visibility="Collapsed"/>
                </Grid>
                <Grid x:Name="PinnedMessageBar" Visibility="Collapsed" Background="#244F7892" Padding="8,5" CornerRadius="10" ColumnSpacing="8" Tapped="OpenCurrentPinnedMessage"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Закреплено" FontWeight="SemiBold" Foreground="#9EDCFA" VerticalAlignment="Center"/>
                  <TextBlock x:Name="PinnedMessagePreview" Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <TextBlock x:Name="PinnedMessageCount" Grid.Column="2" VerticalAlignment="Center" Opacity="0.72"/>
                  <Button Grid.Column="3" Content="↑" Click="PreviousPinnedMessage" ToolTipService.ToolTip="Предыдущее закрепление"/>
                  <Button Grid.Column="4" Content="↓" Click="NextPinnedMessage" ToolTipService.ToolTip="Следующее закрепление"/>
                  <Button Grid.Column="5" Content="Все" Click="OpenPinnedMessagesList"/>
                  <Button Grid.Column="6" Content="×" Click="HidePinnedMessageBar" ToolTipService.ToolTip="Скрыть панель локально"/>
                </Grid></StackPanel>
              </controls:GlassPanel>
              <ListView x:Name="MessageList" Grid.Row="1" Background="Transparent" SelectionMode="Extended" SelectionChanged="SelectMessage" Loaded="MessageListLoaded" ContainerContentChanging="MessageContainerChanging" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="8,8,8,5" HorizontalContentAlignment="Stretch">
                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical"/></ItemsPanelTemplate></ListView.ItemsPanel>
                <ListView.ItemTemplate><DataTemplate>
                  <Grid Margin="{Binding RowMargin}" HorizontalAlignment="Stretch">
                    <Border Visibility="{Binding DateVisibility}" Background="#355E7690" CornerRadius="12" HorizontalAlignment="Center" Padding="12,5" Margin="0,12">
                      <TextBlock Text="{Binding DayText}" FontSize="12"/>
                    </Border>
                    <Grid Visibility="{Binding BubbleVisibility}" HorizontalAlignment="{Binding Alignment}" MaxWidth="{Binding BubbleMaxWidth}"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Width="24" Height="24" VerticalAlignment="Bottom" Margin="0,0,4,1" Visibility="{Binding AvatarVisibility}"><Ellipse Fill="#547F99"/><TextBlock Text="{Binding SenderInitial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold"/><Ellipse><Ellipse.Fill><ImageBrush ImageSource="{Binding SenderAvatar}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse></Grid>
                    <Border Grid.Column="1" Background="{Binding BubbleBrush}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="{Binding BubbleCornerRadius}" Padding="9,5" MinWidth="54">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Author}" Visibility="{Binding AuthorVisibility}" Foreground="#9EDBFA" FontWeight="SemiBold" FontSize="11"/>
                        <Border Visibility="{Binding QuoteVisibility}" Background="#2689BFE0" BorderBrush="#89CDEB" BorderThickness="3,0,0,0" Padding="8,4" CornerRadius="4">
                          <StackPanel><TextBlock Text="Ответ" FontSize="10" Foreground="#9EDCFA"/><TextBlock Text="{Binding Quote}" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel>
                        </Border>
                        <StackPanel Visibility="{Binding MediaVisibility}" Loaded="MessageMediaLoaded" Spacing="5">
                          <Image Source="{Binding MediaPreview}" Visibility="{Binding ImageVisibility}" MaxWidth="440" MaxHeight="360" Stretch="Uniform" Tapped="OpenMessageMedia"/>
                          <Grid Visibility="{Binding VideoVisibility}" MinWidth="280" MinHeight="170">
                            <Image Source="{Binding MediaPreview}" MaxWidth="440" MaxHeight="300" Stretch="UniformToFill" Opacity="0.9"/>
                            <MediaPlayerElement Visibility="Collapsed" AreTransportControlsEnabled="True" Stretch="Uniform" MaxWidth="520" MinHeight="210"/>
                            <Button Content="▶" FontSize="26" Width="58" Height="58" CornerRadius="29" HorizontalAlignment="Center" VerticalAlignment="Center" Click="PlayInlineVideo"/>
                            <Button Content="Скачать оригинал" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Click="SaveOriginalVideo"/>
                          </Grid>
                          <Grid Visibility="{Binding InlineVideoVisibility}" Width="240" Height="240" HorizontalAlignment="Left" EffectiveViewportChanged="StickerViewportChanged" DataContextChanged="StickerDataContextChanged" Unloaded="StickerUnloaded">
                            <Image Source="{Binding MediaPreview}" Stretch="Uniform" Opacity="0.9"/>
                          </Grid>
                          <Grid Visibility="{Binding TgsVisibility}" Width="240" Height="240" HorizontalAlignment="Left" EffectiveViewportChanged="StickerViewportChanged" DataContextChanged="StickerDataContextChanged" Unloaded="StickerUnloaded">
                            <Image Source="{Binding MediaPreview}" Stretch="Uniform" Opacity="0.9"/>
                          </Grid>
                          <StackPanel Visibility="{Binding DocumentVisibility}" Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8A5;" FontSize="28" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center" MaxWidth="320">
                              <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                              <TextBlock Text="{Binding FileSizeText}" FontSize="11" Opacity="0.65"/>
                            </StackPanel>
                            <Button Content="Скачать / открыть" Click="DownloadOrOpenDocument"/>
                          </StackPanel>
