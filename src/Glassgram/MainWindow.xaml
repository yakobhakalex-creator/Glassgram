          <ToggleSwitch x:Name="ComplexEffectsChoice" Header="Сложные эффекты и отражения" Toggled="GlassSettingChanged"/>
          <StackPanel x:Name="FolderSettingsPanel" Spacing="10">
            <TextBlock Text="Папки чатов" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <TextBlock Text="Папки синхронизируются с Telegram. Удаление папки не удаляет переписки." Opacity="0.7" TextWrapping="Wrap"/>
            <TextBlock x:Name="FolderSettingsEmpty" Text="Пользовательских папок пока нет." Opacity="0.65"/>
            <ListView x:Name="FolderSettingsList" SelectionMode="Single" MaxHeight="280">
              <ListView.ItemTemplate><DataTemplate><Grid Padding="8" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="{Binding Icon}" FontSize="19"/><TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding UnreadText}" Visibility="{Binding UnreadVisibility}" Opacity="0.7" VerticalAlignment="Center"/>
              </Grid></DataTemplate></ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Создать" Click="CreateFolder"/><Button Content="Изменить" Click="EditFolder"/><Button Content="↑" Click="MoveFolderUp"/><Button Content="↓" Click="MoveFolderDown"/><Button Content="Удалить" Click="DeleteFolder"/>
            </StackPanel>
          </StackPanel>
          <Button Content="Сохранить" Click="SaveSettings"/>
          <TextBlock x:Name="SettingsStatus" TextWrapping="Wrap" Foreground="#B6C8D9"/>
          <Button x:Name="LogoutButton" Content="Выйти из Telegram" Click="LogoutTelegram" Visibility="Collapsed" HorizontalAlignment="Left"/>
          <TextBlock x:Name="VersionText" Foreground="#B6C8D9"/>
        </StackPanel></controls:GlassPanel></ScrollViewer>
      </Grid>
    </NavigationView>
    </Grid>
  </Grid>
</Window>
