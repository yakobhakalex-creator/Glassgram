<Window x:Class="Glassgram.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Glassgram.Controls" Title="Glassgram">
  <Grid x:Name="Root" RequestedTheme="Dark" Background="Transparent" AllowDrop="True" DragOver="ConversationDragOver" Drop="ConversationDrop" KeyDown="RootKeyDown">
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Image x:Name="WallpaperLayer" Grid.RowSpan="2" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False"/>
    <Rectangle x:Name="WallpaperVeil" Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0.16"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#281B3E59"/><GradientStop Color="#0CFFFFFF" Offset="0.46"/><GradientStop Color="#36213855" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
    <Grid x:Name="TitleBar" Margin="28,0,150,0">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <FontIcon Glyph="&#xE8F2;" FontSize="17" Foreground="#9FD8F5"/>
        <TextBlock Text="Glassgram" FontSize="16" FontWeight="SemiBold"/>
      </StackPanel>
    </Grid>
    <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto" IsPaneOpen="True" OpenPaneLength="245" CompactPaneLength="48" CompactModeThresholdWidth="850" ExpandedModeThresholdWidth="1080" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="True" SelectionChanged="Navigate">
      <NavigationView.PaneHeader>
        <Border x:Name="BrandPanel" Margin="8,8,8,14" Padding="14" CornerRadius="24" BorderBrush="#65FFFFFF" BorderThickness="1" Background="#2AFFFFFF">
          <StackPanel Orientation="Horizontal" Spacing="12"><Border Width="44" Height="44" CornerRadius="22" Background="#3BFFFFFF"><FontIcon Glyph="&#xE8F2;" FontSize="22" Foreground="#D9F5FF"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Glassgram" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Telegram + локальный ИИ" FontSize="11" Opacity="0.72"/></StackPanel></StackPanel>
        </Border>
      </NavigationView.PaneHeader>
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Сообщения" Tag="chats" Icon="Message" IsSelected="True"/>
        <NavigationViewItem Content="ИИ-агенты" Tag="agent" Icon="Contact"/>
        <NavigationViewItem Content="Локальный ИИ" Tag="ai" Icon="Help"/>
        <NavigationViewItem Content="Суммаризация" Tag="summarize"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Черновик ответа" Tag="draft"><NavigationViewItem.Icon><FontIcon Glyph="&#xE70F;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Перевод" Tag="translate"><NavigationViewItem.Icon><FontIcon Glyph="&#xF2B7;"/></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <Grid Margin="10,0,18,18">
        <Grid x:Name="AuthPage" Visibility="Collapsed">
          <Border MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{ThemeResource GlassPanelBrush}" BorderBrush="#48FFFFFF" BorderThickness="1" CornerRadius="24" Padding="36">
            <ScrollViewer MaxHeight="650"><StackPanel Spacing="16">
              <TextBlock Text="Telegram в Glassgram" FontSize="30" FontWeight="SemiBold" />
              <TextBlock x:Name="AuthDescription" Text="Подключаем Telegram…" Foreground="#B6C8D9" TextWrapping="Wrap"/>
              <StackPanel x:Name="CredentialsPanel" Spacing="10" Visibility="Collapsed">
                <TextBox x:Name="ApiIdInput" Header="API ID" PlaceholderText="Число из my.telegram.org" InputScope="Number"/>
                <PasswordBox x:Name="ApiHashInput" Header="API hash" PlaceholderText="Ключ из my.telegram.org"/>
                <TextBlock Text="Получить API ID и API hash можно на my.telegram.org. Они нужны TDLib для входа." Foreground="#B6C8D9" TextWrapping="Wrap"/>
                <Button x:Name="SaveCredentialsButton" Content="Подключить Telegram" Click="SaveTelegramCredentials"/>
              </StackPanel>
              <StackPanel x:Name="PhonePanel" Spacing="12" Visibility="Collapsed">
                <TextBox x:Name="PhoneInput" Header="Номер телефона" PlaceholderText="+380…" InputScope="TelephoneNumber"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="PhoneButton" Content="Получить код" Click="SubmitPhone"/>
                  <Button x:Name="QrButton" Content="Войти по QR-коду" Click="StartQr"/>
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="QrPanel" Spacing="12" Visibility="Collapsed">
                <Border Background="White" Padding="12" CornerRadius="12" HorizontalAlignment="Left"><Image x:Name="QrImage" Width="220" Height="220"/></Border>
                <TextBlock Text="Открой Telegram на телефоне → Настройки → Устройства → Подключить устройство и отсканируй код." TextWrapping="Wrap" Foreground="#B6C8D9"/>
                <Button Content="Войти по номеру" Click="ShowPhone" HorizontalAlignment="Left"/>
              </StackPanel>
              <StackPanel x:Name="CodePanel" Spacing="12" Visibility="Collapsed">
                <TextBox x:Name="CodeInput" Header="Код подтверждения" PlaceholderText="Код из Telegram или SMS"/>
                <Button x:Name="CodeButton" Content="Продолжить" Click="SubmitCode" HorizontalAlignment="Left"/>
              </StackPanel>
              <StackPanel x:Name="EmailPanel" Spacing="12" Visibility="Collapsed">
                <TextBox x:Name="EmailInput" Header="Адрес электронной почты" PlaceholderText="Адрес для кода Telegram"/>
                <Button x:Name="EmailButton" Content="Отправить код" Click="SubmitEmail" HorizontalAlignment="Left"/>
              </StackPanel>
              <StackPanel x:Name="EmailCodePanel" Spacing="12" Visibility="Collapsed">
                <TextBox x:Name="EmailCodeInput" Header="Код из письма"/>
                <Button x:Name="EmailCodeButton" Content="Подтвердить" Click="SubmitEmailCode" HorizontalAlignment="Left"/>
              </StackPanel>
              <StackPanel x:Name="PasswordPanel" Spacing="12" Visibility="Collapsed">
                <PasswordBox x:Name="PasswordInput" Header="Облачный пароль Telegram"/>
                <Button x:Name="PasswordButton" Content="Войти" Click="SubmitPassword" HorizontalAlignment="Left"/>
              </StackPanel>
              <TextBlock x:Name="AuthError" Foreground="#FFB8AC" TextWrapping="Wrap"/>
            </StackPanel></ScrollViewer>
          </Border>
        </Grid>
        <Grid x:Name="ChatsPage" ColumnSpacing="0">
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="ChatColumn" Width="340" MinWidth="250"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <controls:GlassPanel x:Name="ChatListPanel" CornerRadius="28" BorderBrush="#66FFFFFF" BorderThickness="1" Padding="10">
            <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock Text="Чаты" FontSize="25" FontWeight="SemiBold" Margin="10,5,8,0"/>
              <TextBox x:Name="ChatSearch" Grid.Row="1" PlaceholderText="Поиск в Glassgram" TextChanged="SearchChats"/>
              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="7" Margin="2,0"><Button Content="Все чаты" Click="ShowMainChats"/><Button Content="Архив" Click="ShowArchiveChats"/></StackPanel>
              <ListView x:Name="ChatList" Grid.Row="3" SelectionMode="Single" SelectionChanged="SelectChat" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemTemplate><DataTemplate>
                  <Grid Padding="8,5" ColumnSpacing="11" MinHeight="66">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Width="46" Height="46" VerticalAlignment="Center">
                      <Ellipse Fill="#567F99"/><TextBlock Text="{Binding AvatarLetter}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
                      <Ellipse><Ellipse.Fill><ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" LineHeight="21"/>
                      <TextBlock Text="{Binding Preview}" Opacity="0.65" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1" FontSize="12" LineHeight="18"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="8">
                      <TextBlock Text="{Binding TimeText}" Opacity="0.6" FontSize="11" HorizontalAlignment="Right"/>
                      <Border Visibility="{Binding UnreadVisibility}" Background="#5CA9D4" CornerRadius="10" Padding="6,1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding UnreadText}" FontSize="11" Foreground="White"/>
                      </Border>
                    </StackPanel>
                  </Grid>
                </DataTemplate></ListView.ItemTemplate>
              </ListView>
            </Grid>
          </controls:GlassPanel>
          <Border Grid.Column="1" Background="Transparent" PointerPressed="ResizeChatPressed" PointerMoved="ResizeChatMoved" PointerReleased="ResizeChatReleased" PointerCaptureLost="ResizeChatCaptureLost"/>
          <controls:GlassPanel x:Name="MessagesPanel" Grid.Column="2" CornerRadius="28" BorderBrush="#62FFFFFF" BorderThickness="1">
            <Grid>
            <Grid x:Name="EmptyChat" Padding="48">
              <StackPanel VerticalAlignment="Center" MaxWidth="440" Spacing="18">
                <FontIcon Glyph="&#xE8F2;" FontSize="54" Foreground="#9FD8F5" HorizontalAlignment="Left"/>
                <TextBlock Text="Выбери чат" FontSize="36" FontWeight="SemiBold"/>
                <TextBlock Text="Сообщения появятся здесь." Opacity="0.7" FontSize="16"/>
              </StackPanel>
            </Grid>
            <Grid x:Name="ConversationPage" Visibility="Collapsed" RowSpacing="0">
              <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <controls:GlassPanel x:Name="ConversationHeader" BorderBrush="#48FFFFFF" BorderThickness="0,0,0,1" Padding="20,10" CornerRadius="28,28,0,0">
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="3">
                  <TextBlock x:Name="ActiveChatTitle" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="ActiveChatStatus" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                </StackPanel><TextBox x:Name="MessageSearch" Grid.Column="1" PlaceholderText="Поиск в чате" Visibility="Collapsed" TextChanged="SearchMessages"/></Grid>
              </controls:GlassPanel>
              <ListView x:Name="MessageList" Grid.Row="1" Background="Transparent" SelectionMode="Extended" SelectionChanged="SelectMessage" Loaded="MessageListLoaded" ContainerContentChanging="MessageContainerChanging" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="20,8">
                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical"/></ItemsPanelTemplate></ListView.ItemsPanel>
                <ListView.ItemTemplate><DataTemplate>
                  <Grid>
                    <Border Visibility="{Binding DateVisibility}" Background="#355E7690" CornerRadius="12" HorizontalAlignment="Center" Padding="12,5" Margin="0,12">
                      <TextBlock Text="{Binding DayText}" FontSize="12"/>
                    </Border>
                    <Border Visibility="{Binding BubbleVisibility}" Background="{Binding BubbleBrush}" CornerRadius="17" Padding="11,7" Margin="0,1" MaxWidth="560" HorizontalAlignment="{Binding Alignment}">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Author}" Opacity="0.75" FontSize="11"/>
                        <Border Visibility="{Binding QuoteVisibility}" Background="#2689BFE0" BorderBrush="#89CDEB" BorderThickness="3,0,0,0" Padding="8,4" CornerRadius="4">
                          <TextBlock Text="{Binding Quote}" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12"/>
                        </Border>
                        <StackPanel Visibility="{Binding MediaVisibility}" Loaded="MessageMediaLoaded" Spacing="5">
                          <Image Source="{Binding MediaPreview}" Visibility="{Binding ImageVisibility}" MaxWidth="440" MaxHeight="360" Stretch="Uniform" Tapped="OpenMessageMedia"/>
                          <Grid Visibility="{Binding VideoVisibility}" MinWidth="280" MinHeight="170">
                            <Image Source="{Binding MediaPreview}" MaxWidth="440" MaxHeight="300" Stretch="UniformToFill" Opacity="0.9"/>
                            <MediaPlayerElement Visibility="Collapsed" AreTransportControlsEnabled="True" Stretch="Uniform" MaxWidth="520" MinHeight="210"/>
                            <Button Content="▶" FontSize="26" Width="58" Height="58" CornerRadius="29" HorizontalAlignment="Center" VerticalAlignment="Center" Click="PlayInlineVideo"/>
                            <Button Content="Скачать оригинал" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Click="SaveOriginalVideo"/>
                          </Grid>
                          <Button Visibility="{Binding InlineVideoVisibility}" Content="▶ Воспроизвести анимацию" Tapped="OpenMessageMedia" HorizontalAlignment="Left"/>
                          <Button Visibility="{Binding TgsVisibility}" Content="▶ Анимированный стикер" Tapped="OpenMessageMedia" HorizontalAlignment="Left"/>
                          <StackPanel Visibility="{Binding DocumentVisibility}" Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8A5;" FontSize="28" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center" MaxWidth="320">
                              <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                              <TextBlock Text="{Binding FileSizeText}" FontSize="11" Opacity="0.65"/>
                            </StackPanel>
                            <Button Content="Скачать / открыть" Click="DownloadOrOpenDocument"/>
                          </StackPanel>
                          <StackPanel Visibility="{Binding TransferVisibility}" Spacing="2">
                            <ProgressBar Value="{Binding TransferProgress}" Maximum="100"/>
                            <TextBlock Text="{Binding TransferText}" FontSize="11" Opacity="0.7"/>
                          </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="15"/>
                        <HyperlinkButton Content="{Binding PrimaryLink}" Tag="{Binding PrimaryLink}" Visibility="{Binding LinkVisibility}" Click="OpenMessageLink" Padding="0" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5">
                          <TextBlock Text="{Binding TimeText}" FontSize="10" Opacity="0.65"/>
                          <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#8ED7FA"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </Grid>
                </DataTemplate></ListView.ItemTemplate>
              </ListView>
              <Button x:Name="JumpToLatestButton" Grid.Row="1" Content="↓" Width="42" Height="42" CornerRadius="21" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,18" Click="JumpToLatest" Visibility="Collapsed" ToolTipService.ToolTip="К последнему сообщению"/>
              <Border x:Name="HistoryLoadingPanel" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8" Padding="12,6" CornerRadius="14" Background="{ThemeResource GlassPanelBrush}" BorderBrush="#32FFFFFF" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ProgressRing x:Name="HistoryLoadingRing" Width="18" Height="18" IsActive="False"/>
                  <TextBlock x:Name="HistoryLoadingText" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
              </Border>
              <Grid x:Name="MessageActions" Grid.Row="2" Visibility="Collapsed" Padding="16,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="ReplyButton" Content="Ответить" Click="ReplyToMessage"/>
                <Button x:Name="EditButton" Grid.Column="1" Content="Изменить" Click="EditSelectedMessage"/>
                <Button x:Name="DeleteButton" Grid.Column="2" Content="Удалить" Click="DeleteSelectedMessage"/>
                <Button x:Name="ForwardButton" Grid.Column="3" Content="Переслать" Click="ForwardSelectedMessages"/>
              </Grid>
              <Grid x:Name="ComposerPanel" Grid.Row="3" Padding="14,10" Margin="10" CornerRadius="24" RowSpacing="8" ColumnSpacing="10">
                <Grid.Background><AcrylicBrush TintColor="#49677E" TintOpacity="0.72" TintLuminosityOpacity="0.30" FallbackColor="#E0223342"/></Grid.Background>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel x:Name="ComposeContext" Visibility="Collapsed" Orientation="Horizontal" Spacing="10" Grid.ColumnSpan="3">
                  <TextBlock x:Name="ComposeContextText" TextTrimming="CharacterEllipsis" MaxWidth="540" VerticalAlignment="Center"/>
                  <Button Content="Отмена" Click="CancelMessageAction"/>
                </StackPanel>
                <Button x:Name="AttachButton" Grid.Row="1" Content="＋" Click="PickAttachment" VerticalAlignment="Bottom" ToolTipService.ToolTip="Прикрепить файл"/>
                <TextBox x:Name="MessageInput" Grid.Row="1" Grid.Column="1" PlaceholderText="Напиши сообщение…" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="110" TextChanged="MessageInputChanged" PreviewKeyDown="MessageInputPreviewKeyDown"/>
                <Button x:Name="SendMessageButton" Grid.Row="1" Grid.Column="2" Content="Отправить" Click="SendTelegramMessage" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="MessengerStatus" Grid.Row="2" Grid.ColumnSpan="3" FontSize="12" Opacity="0.65" TextWrapping="Wrap"/>
              </Grid>
            </Grid>
            </Grid>
          </controls:GlassPanel>
        </Grid>
        <Grid x:Name="AiPage" Visibility="Collapsed" RowSpacing="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Spacing="8"><TextBlock Text="Локальный ИИ" FontSize="28" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Spacing="12"><ComboBox x:Name="Models" PlaceholderText="Выбери модель" MinWidth="250" SelectionChanged="ModelChanged"/><Button x:Name="RefreshButton" Content="Проверить Ollama" Click="RefreshModels"/></StackPanel>
          </StackPanel>
          <Border Grid.Row="1" Background="{ThemeResource GlassPanelBrush}" CornerRadius="18" Padding="20">
            <ScrollViewer x:Name="ConversationScroll"><StackPanel x:Name="Conversation" Spacing="16"/></ScrollViewer>
          </Border>
          <TextBlock x:Name="AiStatus" Grid.Row="2" Text="Подключение к Ollama на этом компьютере" Foreground="#B6C8D9" TextWrapping="Wrap"/>
          <Grid Grid.Row="3" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="Prompt" PlaceholderText="Напиши сообщение…" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"/>
            <Button x:Name="SendButton" Grid.Column="1" Content="Отправить" Click="Send" VerticalAlignment="Bottom"/>
          </Grid>
        </Grid>
        <Grid x:Name="AgentPage" Visibility="Collapsed" RowSpacing="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Spacing="8">
            <TextBlock Text="ИИ-агент" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Работает локально через Ollama и использует последние сообщения открытого чата. Ничего не отправляет в Telegram автоматически." Opacity="0.7" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="12"><ComboBox x:Name="AgentModels" PlaceholderText="Выбери модель" MinWidth="250"/><Button Content="Обновить модели" Click="RefreshModels"/></StackPanel>
          </StackPanel>
          <Border Grid.Row="1" Background="{ThemeResource GlassPanelBrush}" CornerRadius="18" Padding="20">
            <ScrollViewer x:Name="AgentScroll"><StackPanel x:Name="AgentConversation" Spacing="16"/></ScrollViewer>
          </Border>
          <TextBlock x:Name="AgentStatus" Grid.Row="2" Text="Открой чат, поставь задачу — агент предложит ответ или действие." Foreground="#B6C8D9" TextWrapping="Wrap"/>
          <Grid Grid.Row="3" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="AgentPrompt" PlaceholderText="Например: предложи короткий ответ на последние сообщения" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"/>
            <Button x:Name="AgentSendButton" Grid.Column="1" Content="Запустить" Click="RunAgent" VerticalAlignment="Bottom"/>
          </Grid>
        </Grid>
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Auto"><controls:GlassPanel x:Name="SettingsGlassPanel" BorderBrush="#62FFFFFF" BorderThickness="1" CornerRadius="28" Padding="28" HorizontalAlignment="Left"><StackPanel Spacing="18" MaxWidth="760" Padding="8,0,16,24">
          <TextBlock Text="Внешний вид Glassgram" FontSize="30" FontWeight="SemiBold"/>
          <TextBlock Text="Сервер Ollama" FontWeight="SemiBold"/>
          <TextBox x:Name="Endpoint" Text="http://127.0.0.1:11434" Header="Адрес локального сервера"/>
          <ComboBox x:Name="ThemeChoice" Header="Тема оформления" SelectionChanged="ThemeChanged" MinWidth="190">
            <ComboBoxItem Content="Тёмная" Tag="Dark"/><ComboBoxItem Content="Светлая" Tag="Light"/>
          </ComboBox>
          <ComboBox x:Name="SendModeChoice" Header="Отправка сообщения" MinWidth="240">
            <ComboBoxItem Content="Enter отправляет" Tag="Enter"/><ComboBoxItem Content="Ctrl+Enter отправляет" Tag="CtrlEnter"/>
          </ComboBox>
          <ToggleSwitch x:Name="MinimizeToTrayChoice" Header="Ctrl+W сворачивает приложение"/>
          <ToggleSwitch x:Name="LiquidGlassChoice" Header="Liquid Glass" Toggled="GlassSettingChanged"/>
          <ToggleSwitch x:Name="AdaptiveWallpaperChoice" Header="Адаптация под обои Windows" Toggled="GlassSettingChanged"/>
          <ComboBox x:Name="WallpaperChoice" Header="Обои чата" SelectionChanged="GlassSettingChanged" MinWidth="240">
            <ComboBoxItem Content="Обои Windows" Tag="Windows"/><ComboBoxItem Content="Свой фон" Tag="Custom"/><ComboBoxItem Content="Tahoe Blue" Tag="Tahoe"/><ComboBoxItem Content="Pacific Mist" Tag="Pacific"/><ComboBoxItem Content="Graphite Aurora" Tag="Graphite"/>
          </ComboBox>
          <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Выбрать свой фон…" Click="ChooseCustomWallpaper"/><TextBlock x:Name="WallpaperStatus" VerticalAlignment="Center" Opacity="0.7" TextTrimming="CharacterEllipsis" MaxWidth="390"/></StackPanel>
          <StackPanel Spacing="4"><TextBlock Text="Прозрачность"/><Slider x:Name="TransparencyChoice" Minimum="0" Maximum="90" StepFrequency="5" ValueChanged="GlassSettingChanged"/></StackPanel>
          <StackPanel Spacing="4"><TextBlock Text="Интенсивность размытия"/><Slider x:Name="BlurChoice" Minimum="0" Maximum="100" StepFrequency="5" ValueChanged="GlassSettingChanged"/></StackPanel>
          <StackPanel Spacing="4"><TextBlock Text="Насыщенность стекла"/><Slider x:Name="SaturationChoice" Minimum="0" Maximum="100" StepFrequency="5" ValueChanged="GlassSettingChanged"/></StackPanel>
          <ToggleSwitch x:Name="AnimationsChoice" Header="Анимации интерфейса" Toggled="GlassSettingChanged"/>
          <ToggleSwitch x:Name="ComplexEffectsChoice" Header="Сложные эффекты и отражения" Toggled="GlassSettingChanged"/>
          <Button Content="Сохранить" Click="SaveSettings"/>
          <TextBlock x:Name="SettingsStatus" TextWrapping="Wrap" Foreground="#B6C8D9"/>
          <Button x:Name="LogoutButton" Content="Выйти из Telegram" Click="LogoutTelegram" Visibility="Collapsed" HorizontalAlignment="Left"/>
          <TextBlock Text="Glassgram 0.5.0 · C#, WinUI 3 и TDLib" Foreground="#B6C8D9"/>
        </StackPanel></controls:GlassPanel></ScrollViewer>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
